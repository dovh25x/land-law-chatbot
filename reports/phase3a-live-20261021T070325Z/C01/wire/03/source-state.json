  "synthesis_sources": {
    "luat-dat-dai-2024-97-1-0": {
      "citation_id": "luat-dat-dai-2024-97-1-0",
      "document_id": "luat-dat-dai-2024",
      "locator": "Điều 95",
      "text": "Điều 95. Điều kiện được bồi thường về đất khi Nhà nước thu hồi đất vì mục đích quốc phòng, an ninh; phát triển kinh tế - xã hội vì lợi ích quốc gia, công cộng\n1. Các trường hợp được bồi thường về đất khi Nhà nước thu hồi đất vì mục đích quốc phòng, an ninh; phát triển kinh tế - xã hội vì lợi ích quốc gia, công cộng bao gồm:\na) Hộ gia đình, cá nhân đang sử dụng đất không phải là đất thuê trả tiền thuê đất hằng năm;",
      "applicability": "current",
      "clause_spans": [
        {
          "number": "1",
          "start": 159,
          "end": 417
        }
      ]
    },
    "luat-dat-dai-2024-98-0-parent": {
      "citation_id": "luat-dat-dai-2024-98-0-parent",
      "document_id": "luat-dat-dai-2024",
      "locator": "Điều 95 · ngữ cảnh",
      "text": "2. Các trường hợp quy định tại khoản 1 Điều này được bồi thường về đất khi có một trong các điều kiện sau đây:\na) Có Giấy chứng nhận quyền sử dụng đất hoặc Giấy chứng nhận quyền sở hữu nhà ở và quyền sử dụng đất ở hoặc Giấy chứng nhận quyền sử dụng đất, quyền sở hữu nhà ở và tài sản khác gắn liền với đất hoặc Giấy chứng nhận quyền sử dụng đất, quyền sở hữu tài sản gắn liền với đất;\nb) Có quyết định giao đất hoặc quyết định cho thuê đất hoặc quyết định cho phép chuyển mục đích sử dụng đất của cơ quan nhà nước có thẩm quyền;",
      "applicability": "current",
      "clause_spans": [
        {
          "number": "2",
          "start": 0,
          "end": 528
        }
      ],
