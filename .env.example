# Copy to .env. Never commit keys. No payment method / paid plan is required.
APP_ENV=development
# Explicit selection; no automatic provider changes or billing upgrades.
LLM_PROVIDER=groq
EMBEDDING_MODEL=multilingual-e5-small-onnx-q8-window-v1
EMBEDDING_DIMENSIONS=384
EMBEDDING_PROVIDER=local_onnx
EMBEDDING_CONCURRENCY=2
# Supabase transaction/session pooler URL, sslmode=require. Production requires it.
DATABASE_URL=
# Owner connection for offline migrations/publication only; do not configure it on Render.
ADMIN_DATABASE_URL=
# Fernet key for encrypted session backups, kept separately from backup archives.
BACKUP_ENCRYPTION_KEY=
SQLITE_PATH=data/ring4.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Generate once with: python -c 'import secrets; print(secrets.token_hex(32))'
IP_HASH_SECRET=
TRUST_PROXY_HEADERS=false
MAX_CONCURRENT_REQUESTS=2
TURN_TIMEOUT_SECONDS=90
SESSION_RETENTION_DAYS=7
# Optional deployment credentials, used by CLI only (never frontend).
GITHUB_REPOSITORY=
GITHUB_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=hanoi-land-law
RENDER_API_KEY=
RENDER_SERVICE_ID=
# Local Vite uses its API proxy. Production uses https://hanoi-land-law.pages.dev
VITE_API_BASE_URL=

# Offline E5: EMBEDDING_PROVIDER=local_onnx; EMBEDDING_MODEL=multilingual-e5-small-onnx-q8-window-v1; EMBEDDING_DIMENSIONS=384
LOCAL_EMBEDDING_MODEL_DIR=models/e5
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Backend and Cloudflare Pages share INGRESS_SECRET; never VITE_*.
INGRESS_SECRET=
TURNSTILE_SECRET_KEY=
PUBLIC_HOSTNAME=hanoi-land-law.pages.dev
PUBLIC_DAILY_LLM_LIMIT=100
PUBLIC_DAILY_TOKEN_LIMIT=100000
GENERATION_ENABLED=true
DB_STATEMENT_TIMEOUT_MS=8000
# Public browser configuration only.
VITE_TURNSTILE_SITE_KEY=
# Pages Function binding only (not a VITE variable).
BACKEND_ORIGIN=https://land-law-chatbot.onrender.com
