# Copy to .env. Never commit keys. No payment method / paid plan is required.
APP_ENV=development
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Explicit selection; no automatic provider changes or billing upgrades.
LLM_PROVIDER=gemini
CLOUDFLARE_LLM_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
EMBEDDING_PROVIDER=gemini
EMBEDDING_CONCURRENCY=2
CLOUDFLARE_AI_API_TOKEN=
# Supabase transaction/session pooler URL, sslmode=require. Production requires it.
DATABASE_URL=
# Owner connection for offline migrations/publication only; do not configure it on Render.
ADMIN_DATABASE_URL=
# Fernet key for encrypted session backups, kept separately from backup archives.
BACKUP_ENCRYPTION_KEY=
SQLITE_PATH=data/local.db
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=legal-corpus
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Generate once with: python -c 'import secrets; print(secrets.token_hex(32))'
IP_HASH_SECRET=
TRUST_PROXY_HEADERS=false
MAX_CONCURRENT_REQUESTS=2
TURN_TIMEOUT_SECONDS=90
SESSION_RETENTION_DAYS=7
# Optional deployment credentials, used by CLI only (never frontend).
GITHUB_REPOSITORY=
GITHUB_TOKEN=
# Non-secret checksum of immutable private checkpoint seed, set by operator script.
EMBEDDING_SEED_SHA256=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=hanoi-land-law
RENDER_API_KEY=
RENDER_SERVICE_ID=
# Frontend public URL of backend; this is not a secret.
VITE_API_BASE_URL=http://localhost:8000

# Offline E5: EMBEDDING_PROVIDER=local_onnx; EMBEDDING_MODEL=multilingual-e5-small-onnx-q8-window-v1; EMBEDDING_DIMENSIONS=384
LOCAL_EMBEDDING_MODEL_DIR=models/e5
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
